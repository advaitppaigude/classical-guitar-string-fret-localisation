diff --git a/fpga/rtl/full_classifier.sv b/fpga/rtl/full_classifier.sv
index a6a1ba2..056bcfe 100644
--- a/fpga/rtl/full_classifier.sv
+++ b/fpga/rtl/full_classifier.sv
@@ -6,7 +6,7 @@ module full_classifier #(
     input logic rst,
     input logic start,
     input model_pkg::note_t note,
-    input logic [BITS-1:0] features [0:7],
+    input logic signed [BITS-1:0] features [0:7],
     output logic [1:0] class_index,
     output logic valid
 );
@@ -18,13 +18,27 @@ module full_classifier #(
     logic signed [BITS-1:0] weights_c [0:7];
     logic signed [ACC_BITS-1:0] biases_c;
 
+    logic signed [BITS-1:0] weights [0:23];
+    logic signed [ACC_BITS-1:0] biases [0:2];
 
+    genvar i;
+    generate
+        for (i = 0; i < 8; i = i + 1) begin : connect_weights
+            assign weights[i]      = weights_a[i];
+            assign weights[i + 8]  = weights_b[i];
+            assign weights[i + 16] = weights_c[i];
+        end
+    endgenerate
+
+    assign biases[0] = biases_a;
+    assign biases[1] = biases_b;
+    assign biases[2] = biases_c;
 
     load_model #(.BITS(BITS), .ACC_BITS(ACC_BITS)) u_load(.note(note), .weights_a(weights_a), .weights_b(weights_b), .weights_c(weights_c),
     .biases_a(biases_a), .biases_b(biases_b), .biases_c(biases_c));
 
     parametrised_note_classifier_fsm #(.BITS(BITS), .ACC_BITS(ACC_BITS)) u_classifier(.clk(clk), .rst(rst), .start(start), .feature_regs(features),
-     .weights({weights_a, weights_b, weights_c}),
-     .biases({biases_a, biases_b, biases_c}), .class_index(class_index), .valid(valid));
+     .weights(weights),
+     .biases(biases), .class_index(class_index), .valid(valid));
 
 endmodule
diff --git a/fpga/rtl/load_model.sv b/fpga/rtl/load_model.sv
index 0392d47..3492624 100644
--- a/fpga/rtl/load_model.sv
+++ b/fpga/rtl/load_model.sv
@@ -11,8 +11,8 @@ combinational model selection supplies coefficients to three parallel MAC units
 module load_model # (
     parameter int BITS = 6,
     parameter int ACC_BITS = 2 * BITS + 4,
-    parameter string WEIGHTS_FILE = "rom/b6_f3_weights.mem",
-    parameter string BIASES_FILE  = "rom/b6_f3_biases.mem"
+    parameter WEIGHTS_FILE = "rom/b6_f3_weights.mem",
+    parameter BIASES_FILE  = "rom/b6_f3_biases.mem"
 )(
     input model_pkg::note_t note,
     output logic signed [BITS-1:0] weights_a [0:7],
@@ -23,26 +23,32 @@ module load_model # (
     output logic signed [ACC_BITS-1:0] biases_c
 );
 
-    /*
-    decided to implement a "2D array" structure
-    so that the note can be used directly to access models
-    and the relevant weights needed for the 3 MAC units
-    */
-    logic signed [BITS-1:0] weight_rom [0:4][0:23];
-    logic signed [ACC_BITS-1:0] bias_rom [0:4][0:2];
-
+    // Quartus requires one-dimensional memories for $readmemh.
+    // Each note occupies 24 consecutive weights and three consecutive biases.
+    logic signed [BITS-1:0] weight_rom [0:119];
+    logic signed [ACC_BITS-1:0] bias_rom [0:14];
+    int unsigned weight_base;
+    int unsigned bias_base;
 
     initial begin
         $readmemh(WEIGHTS_FILE, weight_rom);
         $readmemh(BIASES_FILE, bias_rom);
     end
 
-    assign weights_a = weight_rom[note][0:7];
-    assign weights_b = weight_rom[note][8:15];
-    assign weights_c = weight_rom[note][16:23];
-    
-    assign biases_a  = bias_rom[note][0];
-    assign biases_b  = bias_rom[note][1];
-    assign biases_c  = bias_rom[note][2];
+    assign weight_base = 24 * int'(note);
+    assign bias_base   = 3 * int'(note);
+
+    genvar i;
+    generate
+        for (i = 0; i < 8; i = i + 1) begin : select_weights
+            assign weights_a[i] = weight_rom[weight_base + i];
+            assign weights_b[i] = weight_rom[weight_base + 8 + i];
+            assign weights_c[i] = weight_rom[weight_base + 16 + i];
+        end
+    endgenerate
+
+    assign biases_a = bias_rom[bias_base];
+    assign biases_b = bias_rom[bias_base + 1];
+    assign biases_c = bias_rom[bias_base + 2];
 
 endmodule
